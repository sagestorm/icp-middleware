{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagestorm.github.io/interrogative-collection-protocol/schemas/coding.key.v1.json",
  "title": "ICP Sealed Coding Key v1",
  "description": "Steward-held sealed coding key. MUST NEVER be embedded in or transmitted with an analysis packet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_packet_id",
    "protocol_version",
    "created_at_utc",
    "shuffle_seed",
    "respondent_map",
    "knowledge_map",
    "fact_map"
  ],
  "properties": {
    "review_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "shuffle_seed": {
      "description": "Steward-private seed used to permute analysis units.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "respondent_map": {
      "type": "object",
      "description": "Map of respondent_token to steward-private label.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^R-[A-Z0-9]{12}$"
      },
      "minProperties": 1
    },
    "knowledge_map": {
      "type": "object",
      "description": "Map of knowledge_condition_id to pack descriptor.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^K-[0-9]{2}$"
      },
      "minProperties": 1
    },
    "fact_map": {
      "type": "object",
      "description": "Map of fact_ref id to fact-sheet line or text.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^F-[0-9]{3}$"
      },
      "minProperties": 1
    },
    "record_map": {
      "type": "object",
      "description": "Optional map of analysis unit_id to original record_id.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    }
  }
}
